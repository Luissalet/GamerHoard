# Optional keys. Do not commit credentials; .env files are gitignored.
# RAWG_API_KEY=...          server and MCP process: catalogue search and metadata
# GAMERHOARD_DATA_FILE=C:\Users\yourname\.gamerhoard\library.json
# GAMERHOARD_PORT=5207      local web app port
# EXPO_PUBLIC_BACKEND=localapi  shared web; memory/local historical browser; supabase cloud
# EXPO_PUBLIC_SUPABASE_URL=...
# EXPO_PUBLIC_SUPABASE_ANON_KEY=...  public client key, never a service-role secret
