# Public config for the mobile/web client. Nothing secret belongs here.

# Backend: 'localapi' (web served by the local server, default) | 'memory' (browser demo)
#          | 'local' (on-device SQLite, native builds) | 'supabase' (cloud, legacy)
EXPO_PUBLIC_BACKEND=localapi

# RAWG API key for NATIVE builds only. The web app uses the local server's RAWG_API_KEY.
EXPO_PUBLIC_RAWG_KEY=