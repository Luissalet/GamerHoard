{
  "name": "gamerhoard-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local single-user video game library: web app, Faustus MCP tools and a native app over the same library",
  "workspaces": [
    "apps/mobile"
  ],
  "scripts": {
    "start": "node mcp/server.mjs",
    "server": "node server/index.mjs",
    "setup": "npm install --prefix server",
    "build:web": "npm run build:web --workspace @gamerhoard/mobile",
    "web": "npm run web --workspace @gamerhoard/mobile",
    "typecheck": "npm run typecheck --workspace @gamerhoard/mobile",
    "test": "node --test \"mcp/*.test.mjs\" \"server/*.test.mjs\" \"apps/mobile/src/*.test.mjs\""
  },
  "engines": {
    "node": ">=20"
  }
}
